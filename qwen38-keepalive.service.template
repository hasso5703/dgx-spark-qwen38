[Unit]
Description=Keepalive proxy in front of the serving engine :__PORT__ (agent clients connect to :__PROXY_PORT__)
After=network-online.target qwen38-sglang.service qwen38-flash.service qwen38-kolibri.service qwen38-nemotron.service qwen38-nemotron-super.service
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__GROUP__
Environment=UPSTREAM=http://127.0.0.1:__PORT__
Environment=PROMPT_CEILING_TOKENS=__PROMPT_CEILING__
# applied while the flash lane serves, whichever lane was installed or switched to last
Environment=FLASH_PROMPT_CEILING_TOKENS=__FLASH_PROMPT_CEILING__
Environment=KEEPALIVE_S=10
Environment=MAX_SILENCE_S=3600
# A request that finds the engine not answering while one of these units is on its way
# back (a crash, a boot, a switch) waits for it instead of failing at once (v6.28, issue
# #26), and a new start of one drops what the proxy read from the engine before it: its
# pool, window and names (v6.35). Quoted: unquoted, systemd would read the space as two
# assignments.
Environment="PROXY_HOLD_UNITS=qwen38-sglang.service qwen38-flash.service qwen38-kolibri.service qwen38-nemotron.service qwen38-nemotron-super.service"
Environment=PROXY_HOLD_MAX_S=1200
Environment=PROXY_BIND=__PROXY_BIND__
# A ceiling on the proxy's own memory, so a proxy that grows past any real use is stopped
# alone and started again 3 s later (Restart=always), and never eats the memory the engine
# lives in. Its highest peak over two weeks of real traffic on the reference box was 101 MB
# (systemd's own accounting, 2026-09-24 to 10-07). Both lines are needed: with swap on the
# box, MemoryMax alone moves the excess to swap instead (measured 2026-10-08: a unit capped
# at 100M held 300M; with MemorySwapMax=0 the kernel stopped it at 100M, in its own cgroup).
# It has to hold what the proxy accepts at once too, and a body costs it about four times its
# bytes while the guards work on it (the reasoning_effort route parses it and writes it again):
# one body of 250 MiB, under MAX_BODY_BYTES, took a unit capped at 1G to the kernel's kill, with
# every stream in flight (measured 2026-10-18 in a cloud container under systemd 255, and not
# yet on the box). 2G holds BODY_BUDGET_BYTES at that rate; tests/test_proxy_memory_ceiling.py
# measures the rate on the machine it runs on and holds the two together.
MemoryMax=2G
MemorySwapMax=0
# The proxy is what a client's bytes reach first, on every address the box has (PROXY_BIND),
# so it gets no more of the machine than it uses: it reads its code, its key, and what the
# operator names (QWEN38_CLIENT_KEYS_FILE, the TLS pair, the lanes' launch scripts), runs
# systemctl to read the lanes' state, and writes nothing on disk. Without these lines a flaw
# of it ran as this user, who is in the docker group with docker's socket one connect away,
# and may run the cockpit's sudo commands (found in a cloud review, 2026-10-18, and not yet
# run on the box: tests/test_proxy_unit_sandbox.py holds what the proxy needs).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
# a call outside the set fails with EPERM in the call, where the default kills the proxy
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
InaccessiblePaths=-/run/docker.sock -/var/run/docker.sock
UMask=0077
ExecStart=/usr/bin/python3 __HOME__/.config/qwen38/keepalive-proxy.py __PROXY_PORT__
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
