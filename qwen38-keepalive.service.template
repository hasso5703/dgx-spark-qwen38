[Unit]
Description=Keepalive proxy in front of the serving engine :__PORT__ (agent clients connect to :__PROXY_PORT__)
After=network-online.target qwen38-sglang.service qwen38-flash.service
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__GROUP__
Environment=UPSTREAM=http://127.0.0.1:__PORT__
Environment=PROMPT_CEILING_TOKENS=__PROMPT_CEILING__
# applied while the flash lane serves, whichever lane was installed or switched to last
Environment=FLASH_PROMPT_CEILING_TOKENS=__FLASH_PROMPT_CEILING__
Environment=KEEPALIVE_S=10
Environment=MAX_SILENCE_S=3600
# A request that finds the engine not answering while one of these units is on its way
# back (a crash, a boot, a switch) waits for it instead of failing at once (v6.28, issue
# #26). Quoted: unquoted, systemd would read the space as two assignments.
Environment="PROXY_HOLD_UNITS=qwen38-sglang.service qwen38-flash.service"
Environment=PROXY_HOLD_MAX_S=1200
Environment=PROXY_BIND=__PROXY_BIND__
# A ceiling on the proxy's own memory, so a proxy that grows past any real use is stopped
# alone and started again 3 s later (Restart=always), and never eats the memory the engine
# lives in. Its highest peak over two weeks of real traffic on the reference box was 101 MB
# (systemd's own accounting, 2026-09-24 to 10-07). Both lines are needed: with swap on the
# box, MemoryMax alone moves the excess to swap instead (measured 2026-10-08: a unit capped
# at 100M held 300M; with MemorySwapMax=0 the kernel stopped it at 100M, in its own cgroup).
MemoryMax=1G
MemorySwapMax=0
ExecStart=/usr/bin/python3 __HOME__/.config/qwen38/keepalive-proxy.py __PROXY_PORT__
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
