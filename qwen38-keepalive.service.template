[Unit]
Description=Keepalive proxy in front of SGLang :__PORT__ (agent clients connect to :__PROXY_PORT__)
After=network-online.target qwen38-sglang.service
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__GROUP__
Environment=UPSTREAM=http://127.0.0.1:__PORT__
Environment=KEEPALIVE_S=10
Environment=MAX_SILENCE_S=3600
ExecStart=/usr/bin/python3 __HOME__/.config/qwen38/keepalive-proxy.py __PROXY_PORT__
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
