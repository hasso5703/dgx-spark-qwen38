[Unit]
Description=Kolibri-1 (Aleph Alpha, vLLM 0.29 + aleph-alpha-inference), OpenAI+Anthropic API :__PORT__
Wants=network-online.target
Requires=docker.service
# One engine at a time on this box, said to systemd: starting this lane stops the others
# and starting another stops this one, the stop finishing before the start in both
# directions (Conflicts= alone orders nothing, hence After= on the same units).
Conflicts=qwen38-sglang.service qwen38-flash.service qwen38-image.service qwen38-video.service qwen38-nemotron.service qwen38-nemotron-super.service
After=network-online.target docker.service qwen38-sglang.service qwen38-flash.service qwen38-image.service qwen38-video.service qwen38-nemotron.service qwen38-nemotron-super.service

[Service]
Type=simple
User=__USER__
Group=__GROUP__
ExecStartPre=-/usr/bin/docker rm -f qwen38-kolibri
# The memory the last engine held has to be back before this one starts (see engine-preflight.sh).
ExecStartPre=/bin/bash __HOME__/.config/qwen38/engine-preflight.sh qwen38-kolibri.service
# The key goes to the server in the file SGLang's lanes read too (see engine-secrets.sh): vLLM
# reads the same YAML with --config and merges it in memory, so the key is on no command line,
# and its "non-default args" log line prints api_key as ***.
ExecStartPre=/bin/bash __HOME__/.config/qwen38/engine-secrets.sh
# Everything below is Aleph Alpha's serving command (the model card's), on their plugin's
# vLLM, with this box's port, key, memory share and the official 262,144-token window:
#   --kv-cache-dtype fp8, the kolibri1 reasoning and tool parsers, auto tool choice.
# The sampling defaults (temperature 1.0, top_p 0.97, top_k 128) are the checkpoint's
# generation_config.json, which vLLM applies to any request that does not set them.
# VLLM_NO_USAGE_STATS and DO_NOT_TRACK: vLLM reports anonymous usage to its authors by
# default; a box that serves its owner's data sends nothing anywhere.
# vllm_engine_auth.RequireKey: vLLM checks the key only under /v1, /v2, /inference and
# /cohere, and /invocations (which runs chat and completions), /tokenize and /detokenize
# answered without it; the middleware asks it everywhere but /health and /metrics, as the
# SGLang lanes do. Its directory alone is mounted, read-only, and it reads the key file.
ExecStart=/bin/bash -c 'exec /usr/bin/docker run --rm --name qwen38-kolibri --gpus all \
  --memory 100g --memory-swap 100g --shm-size 16g --network host --ipc=host \
  -e HF_HUB_OFFLINE=1 -e VLLM_NO_USAGE_STATS=1 -e DO_NOT_TRACK=1 \
  -e PYTHONPATH=/opt/qwen38-auth -e QWEN38_KEY_FILE=/out/api-key \
  -v __HOME__/.config/qwen38/kolibri-cache:/root/.cache/vllm \
  -v __HF_CACHE__:/root/.cache/huggingface \
  -v __HOME__/.config/qwen38:/out:ro \
  -v __HOME__/.config/qwen38/vllm-auth:/opt/qwen38-auth:ro \
  __IMAGE__ \
    __MODEL__ --revision __REV__ \
    --served-model-name kolibri-1 \
    --max-model-len 262144 --kv-cache-dtype fp8 \
    --gpu-memory-utilization __GMU__ --max-num-seqs 16 \
    --reasoning-parser kolibri1 --tool-call-parser kolibri1 --enable-auto-tool-choice \
    --config /out/engine-secrets.yaml --middleware vllm_engine_auth.RequireKey \
    --host __ENGINE_BIND__ --port __PORT__'
ExecStop=-/usr/bin/docker stop -t 20 qwen38-kolibri
Restart=always
# docker stops vLLM with SIGTERM (143) or SIGKILL (137) on a plain stop: a clean stop, not a failure
SuccessExitStatus=137 143
RestartSec=15

[Install]
WantedBy=multi-user.target
