[Unit]
Description=Nemotron 3.5 Super VL (NVIDIA, vLLM nightly), OpenAI+Anthropic API :__PORT__
Wants=network-online.target
Requires=docker.service
# One engine at a time on this box, said to systemd: starting this lane stops the others
# and starting another stops this one, the stop finishing before the start in both
# directions (Conflicts= alone orders nothing, hence After= on the same units).
Conflicts=qwen38-sglang.service qwen38-flash.service qwen38-image.service qwen38-video.service qwen38-kolibri.service qwen38-nemotron.service
After=network-online.target docker.service qwen38-sglang.service qwen38-flash.service qwen38-image.service qwen38-video.service qwen38-kolibri.service qwen38-nemotron.service

[Service]
Type=simple
User=__USER__
Group=__GROUP__
ExecStartPre=-/usr/bin/docker rm -f qwen38-nemotron-super
# The memory the last engine held has to be back before this one starts (see engine-preflight.sh).
ExecStartPre=/bin/bash __HOME__/.config/qwen38/engine-preflight.sh qwen38-nemotron-super.service
# The key goes to the server in the file SGLang's lanes read too (see engine-secrets.sh): vLLM
# reads the same YAML with --config and merges it in memory, so the key is on no command line,
# and its "non-default args" log line prints api_key as ***.
ExecStartPre=/bin/bash __HOME__/.config/qwen38/engine-secrets.sh
# NVIDIA's serving command for a DGX Spark (the model card's quick start: LiLiCorr drafting 7
# tokens, the Mamba state in float16 with stochastic rounding, its shared-prefix checkpoints, the
# video pruned by half at 2 frames a second), with this box's port, key and memory share, and what
# this box measured (docs/nemotron-super-lane.md says how):
#   the window of 1,048,576 tokens, and several requests at a time sharing its cache instead of 1
#   (--max-num-seqs, which the installer pins with the memory share it was measured with);
#   16 images and 2 videos per conversation, and media only inside the request: no local file
#   and no URL fetched (the one domain allowed does not exist);
#   the image of the Nemotron Bolt lane, the card's vLLM nightly short of the cache the window needs
#   at this share once the box's media limits are set.
# The options that take a dict are given by key (--media-io-kwargs.video.fps 2): vLLM's own parser
# builds the same dict, and no JSON goes through systemd and bash.
# Its own caches, so that a boot after the first builds nothing again: vLLM's compile cache and
# FlashInfer's kernels built at their first use, in folders of their own (the Bolt lane compiles
# another model in the same image).
# PYTHONDONTWRITEBYTECODE and HF_MODULES_CACHE: transformers copies the checkpoint's code
# (--trust-remote-code) into a modules folder of the HF cache, made inside the container at each
# start, so nothing root-owned lands in the user's HF cache.
# The sampling defaults (temperature 1.0, top_p 0.95) are the checkpoint's generation_config.json,
# which vLLM applies to any request that does not set them.
# VLLM_NO_USAGE_STATS and DO_NOT_TRACK: vLLM reports anonymous usage to its authors by
# default; a box that serves its owner's data sends nothing anywhere.
# vllm_engine_auth.RequireKey: vLLM checks the key only under /v1, /v2, /inference and
# /cohere; the middleware asks it everywhere but /health and /metrics, as the SGLang lanes do.
ExecStart=/bin/bash -c 'exec /usr/bin/docker run --rm --name qwen38-nemotron-super --gpus all \
  --memory 110g --memory-swap 110g --shm-size 16g --network host --ipc=host \
  -e HF_HUB_OFFLINE=1 -e VLLM_NO_USAGE_STATS=1 -e DO_NOT_TRACK=1 \
  -e PYTHONDONTWRITEBYTECODE=1 -e HF_MODULES_CACHE=/tmp/hf-modules \
  -e PYTHONPATH=/opt/qwen38-auth -e QWEN38_KEY_FILE=/out/api-key \
  -v __HOME__/.config/qwen38/nemotron-super-cache/vllm:/root/.cache/vllm \
  -v __HOME__/.config/qwen38/nemotron-super-cache/flashinfer:/root/.cache/flashinfer \
  -v __HF_CACHE__:/root/.cache/huggingface \
  -v __HOME__/.config/qwen38:/out:ro \
  -v __HOME__/.config/qwen38/vllm-auth:/opt/qwen38-auth:ro \
  __IMAGE__ \
    __MODEL__ --revision __REV__ \
    --served-model-name nemotron-3.5-super-vl --trust-remote-code \
    --max-model-len 1048576 --max-num-seqs __SEQS__ \
    --gpu-memory-utilization __GMU__ --max-num-batched-tokens 8192 \
    --speculative-config.method dflash --speculative-config.model __DRAFT__ \
    --speculative-config.revision __DREV__ --speculative-config.num_speculative_tokens 7 \
    --mamba-backend flashinfer --mamba-ssm-cache-dtype float16 \
    --enable-mamba-cache-stochastic-rounding --mamba-cache-philox-rounds 5 --enable-mamba-shared-prefix-checkpoint \
    --block-size 64 --prefix-match-unit 64 \
    --limit-mm-per-prompt.image 16 --limit-mm-per-prompt.video 2 --video-pruning-rate 0.5 \
    --media-io-kwargs.video.fps 2 --media-io-kwargs.video.num_frames 256 \
    --allowed-media-domains media.invalid \
    --enable-auto-tool-choice --tool-call-parser qwen3_coder --reasoning-parser nemotron_v3 \
    --config /out/engine-secrets.yaml --middleware vllm_engine_auth.RequireKey \
    --host __ENGINE_BIND__ --port __PORT__'
ExecStop=-/usr/bin/docker stop -t 20 qwen38-nemotron-super
Restart=always
# docker stops vLLM with SIGTERM (143) or SIGKILL (137) on a plain stop: a clean stop, not a failure
SuccessExitStatus=137 143
RestartSec=15

[Install]
WantedBy=multi-user.target
