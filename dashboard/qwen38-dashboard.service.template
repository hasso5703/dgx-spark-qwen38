[Unit]
Description=Spark Cockpit (qwen38 dashboard) on __BIND__:__PORT__
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__GROUP__
# Unbuffered, otherwise Python block buffers stdout into the journal pipe and
# the startup line (bind address, degraded collectors) never shows up.
Environment=PYTHONUNBUFFERED=1
Environment=COCKPIT_PORT=__PORT__
Environment=COCKPIT_BIND=__BIND__
Environment=COCKPIT_REPO_DIR=__REPO_DIR__
# Agent tab (dashboard/install-agent.sh): the relay to opencode's web interface,
# gated by the cockpit session. Port 0 = no relay. The bind is "tailscale" (the
# tailnet address, resolved when the interface is up) or an address literal.
Environment=COCKPIT_AGENT_PORT=__AGENT_PORT__
Environment=COCKPIT_AGENT_BIND=__AGENT_BIND__
Environment=COCKPIT_AGENT_UPSTREAM=__AGENT_UPSTREAM__
# Self-restart of a wedged engine, off unless you ask for it. Pair it with
# COCKPIT_AUTOHEAL_GRACE=<seconds> to keep the wedge up for forensics first.
Environment=COCKPIT_AUTOHEAL=0
ExecStart=/usr/bin/python3 __REPO_DIR__/dashboard/cockpit.py
Restart=always
RestartSec=3
# The cockpit is a viewer plus a narrow action surface; keep it boxed.
# NoNewPrivileges stays no: the action surface shells out to sudo -n, which
# cannot elevate under yes. ProtectSystem=full keeps /usr, /boot and the rest
# of /etc read-only for everything in this unit's process tree.
#
# /etc/systemd/system is carved back out, and it has to be. ProtectSystem works
# by giving the unit its own MOUNT NAMESPACE with those paths bound read-only,
# and sudo does not leave a mount namespace: a sudo call from the cockpit is
# root, and root cannot write to a read-only mount either. The comment that
# used to sit here claimed the opposite ("every write goes through a sudo
# install line in the allowlist instead"), and the allowlist entries were
# genuinely there, so the design read as complete while the Switch button
# could not perform a switch. Found on the reference box, 2026-09-14: a switch
# to the flash lane disabled the old unit (systemctl, done by PID 1, works),
# then died on `install: cannot create directory
# '/etc/systemd/system/qwen38-keepalive.service.d': Read-only file system`,
# leaving one lane disabled and the other enabled but not serving.
#
# This is not a loosening of who may write there. The cockpit runs as __USER__,
# and file permissions on /etc/systemd/system are unchanged, so it still cannot
# write a byte on its own; the only way in remains an exact-argv line of
# /etc/sudoers.d/qwen38-cockpit. All this does is stop the namespace from
# vetoing the writes the allowlist already authorises.
NoNewPrivileges=no
ProtectSystem=full
# "-": a path that is not there is skipped. Without it, a missing config folder (the
# cockpit installed on its own, the folder removed) failed every start at the namespace
# step, 226/NAMESPACE, before a line of the cockpit ran (found in review, 2026-09-24).
ReadWritePaths=-__HOME__/.config/qwen38
ReadWritePaths=/etc/systemd/system
PrivateTmp=true

[Install]
WantedBy=multi-user.target
