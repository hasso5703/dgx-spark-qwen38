[Unit]
Description=Spark Cockpit (qwen38 dashboard, BETA) on 127.0.0.1:__PORT__
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__GROUP__
Environment=COCKPIT_PORT=__PORT__
Environment=COCKPIT_BIND=127.0.0.1
Environment=COCKPIT_REPO_DIR=__REPO_DIR__
ExecStart=/usr/bin/python3 __REPO_DIR__/dashboard/cockpit.py
Restart=always
RestartSec=3
# The cockpit is a viewer plus a narrow action surface; keep it boxed.
NoNewPrivileges=no
ProtectSystem=full
ReadWritePaths=__HOME__/.config/qwen38
ReadWritePaths=/etc/systemd/system
PrivateTmp=true

[Install]
WantedBy=multi-user.target
