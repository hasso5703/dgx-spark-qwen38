[Unit]
Description=Spark Cockpit (qwen38 dashboard) on __BIND__:__PORT__
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__GROUP__
# Unbuffered, otherwise Python block buffers stdout into the journal pipe and
# the startup line (bind address, degraded collectors) never shows up.
Environment=PYTHONUNBUFFERED=1
Environment=COCKPIT_PORT=__PORT__
Environment=COCKPIT_BIND=__BIND__
Environment=COCKPIT_REPO_DIR=__REPO_DIR__
# Agent tab (dashboard/install-agent.sh): the relay to opencode's web interface,
# gated by the cockpit session. Port 0 = no relay. The bind is "tailscale" (the
# tailnet address, resolved when the interface is up) or an address literal.
Environment=COCKPIT_AGENT_PORT=__AGENT_PORT__
Environment=COCKPIT_AGENT_BIND=__AGENT_BIND__
Environment=COCKPIT_AGENT_UPSTREAM=__AGENT_UPSTREAM__
# Self-restart of a wedged engine, off unless you ask for it. Pair it with
# COCKPIT_AUTOHEAL_GRACE=<seconds> to keep the wedge up for forensics first.
Environment=COCKPIT_AUTOHEAL=0
ExecStart=/usr/bin/python3 __REPO_DIR__/dashboard/cockpit.py
Restart=always
RestartSec=3
# The cockpit is a viewer plus a narrow action surface; keep it boxed.
NoNewPrivileges=no
ProtectSystem=full
ReadWritePaths=__HOME__/.config/qwen38
ReadWritePaths=/etc/systemd/system
PrivateTmp=true

[Install]
WantedBy=multi-user.target
