 # "through", "high" or "github", the sudoers gate among them, and docker is named by two
 # steps that never run it (found in review, 2026-09-24). Each missing tool gets a stub,
 # first on PATH, that records the call and fails the way a missing command does.
+# The full run's receipt (.cache/ci-pass, below) names a tree only if nothing tracked changed
+# while it ran: a worktree edited during a 45-minute run is not the tree the run tested.
+def worktree_clean():
+    return not subprocess.run(["git", "status", "--porcelain", "--untracked-files=no"],
+                              capture_output=True, text=True).stdout.strip()
+clean_at_start = worktree_clean()
