#!/usr/bin/env bash
# Launch script for qwen38-flash.service, rendered by install.sh (a plain file
# so no systemd-vs-bash double escaping can ever corrupt an argument;
# regenerated on every install; the serve revision is refreshed by switch-model.sh).
# Engine since v1.5: SGLang (same engine as the 27B pair), with the two-file
# overlay that mmaps the 51B PLE table from NVMe and unblocks QSA decode on
# sm_121. Every serving flag here is validated on the reference box; see
# flash-sglang/ATTRIBUTION.md for why each GB10-specific one exists.
set -euo pipefail
exec /usr/bin/docker run --rm --name qwen38-flash --gpus all \
  --memory 110g --memory-swap 110g --shm-size 16g --network host --ipc=host \
  -v __HF_CACHE__:/root/.cache/huggingface \
  -v __HOME__/.config/qwen38:/out \
  -v __PLE_DIR__:/ple \
  -e SGLANG_QWEN4_PLE_MMAP_DIR=/ple \
  -e HF_HUB_OFFLINE=1 \
  __IMAGE__ \
  python3 -m sglang.launch_server \
    --model-path __MODEL__ __MODEL_REV_ARGS__ --tp-size 1 \
    --served-model-name qwen3.8-flash-next \
    --quantization modelopt_fp4 \
    --prefill-attention-backend triton \
    --decode-attention-backend trtllm_mha \
    --ple-offload-embedding \
    --mamba-radix-cache-strategy extra_buffer \
    --mem-fraction-static 0.79 \
    --context-length 262144 \
    --chunked-prefill-size 1024 \
    --max-running-requests 4 \
    --allow-auto-truncate \
    --speculative-algorithm NEXTN \
    --speculative-num-steps 3 \
    --speculative-eagle-topk 1 \
    --speculative-num-draft-tokens 4 \
    --speculative-draft-model-quantization unquant \
    --reasoning-parser qwen3 --tool-call-parser qwen3_coder \
    --chat-template /out/chat-template-flashnext.jinja \
    --api-key "$(cat __HOME__/.config/qwen38/api-key)" \
    --host 0.0.0.0 --port __PORT__
