[Unit]
Description=Nemotron 3.5 Bolt (NVIDIA, vLLM nightly + b12x), OpenAI+Anthropic API :__PORT__
Wants=network-online.target
Requires=docker.service
# One engine at a time on this box, said to systemd: starting this lane stops the others
# and starting another stops this one, the stop finishing before the start in both
# directions (Conflicts= alone orders nothing, hence After= on the same units).
Conflicts=qwen38-sglang.service qwen38-flash.service qwen38-image.service qwen38-video.service qwen38-kolibri.service qwen38-nemotron-super.service
After=network-online.target docker.service qwen38-sglang.service qwen38-flash.service qwen38-image.service qwen38-video.service qwen38-kolibri.service qwen38-nemotron-super.service

[Service]
Type=simple
User=__USER__
Group=__GROUP__
ExecStartPre=-/usr/bin/docker rm -f qwen38-nemotron
# The memory the last engine held has to be back before this one starts (see engine-preflight.sh).
ExecStartPre=/bin/bash __HOME__/.config/qwen38/engine-preflight.sh qwen38-nemotron.service
# The key goes to the server in the file SGLang's lanes read too (see engine-secrets.sh): vLLM
# reads the same YAML with --config and merges it in memory, so the key is on no command line,
# and its "non-default args" log line prints api_key as ***.
ExecStartPre=/bin/bash __HOME__/.config/qwen38/engine-secrets.sh
# NVIDIA's serving command (the model card's, nightly 77154ca6 with b12x), with this box's port,
# key and memory share, and what this box measured better (docs/nemotron-lane.md says how):
#   16 requests at a time instead of 1, 16 images and 2 videos per conversation instead
#   of 1 and 1 (a second screenshot in a session was refused), and media only inside the request:
#   no local file (the card opens "/") and no URL fetched (the one domain allowed does not exist);
#   and the prefix cache's fine settings, which NVIDIA's own Super VL recipe sets (--block-size 64
#   --prefix-match-unit 64 --enable-mamba-shared-prefix-checkpoint): with the card's, the drafter's
#   sliding window aligned every cache hit to 17,984 tokens, and an agent's turn at 40,000 tokens
#   recomputed 22,055 of them, 13.4 s before its first token; with these, 8,231 and 5.0 s, the same
#   answers and speed (the drafter's window still keeps hits to 4,544-token blocks).
# The options that take a dict are given by key (--limit-mm-per-prompt.image 16): vLLM's own
# parser builds the same dict, and no JSON goes through systemd and bash.
# Three caches, each in its own folder of nemotron-cache, so that a boot after the first builds
# nothing again: vLLM's compile cache, FlashInfer's kernels built at their first use and the b12x
# kernels it compiles (measured: 14 MB and 8 MB, about a minute of a boot).
# CUDA graphs run at vLLM's default: the card's first version turned them off, the box measured
# them on +43 to +55 % faster with the same answers, and the card dropped that line at 17:55 UTC.
# PYTHONDONTWRITEBYTECODE and HF_MODULES_CACHE: the reasoning parser is imported from the snapshot,
# and transformers copies the checkpoint's code (--trust-remote-code) into a modules folder of the HF
# cache; vLLM, root in the container, left its __pycache__ in the snapshot and that copy in the
# user's HF cache, both root-owned (found on the reference box, 2026-10-15). The copy is made inside
# the container now, at each start (a few files).
# The sampling defaults (temperature 1.0, top_p 0.95) are the checkpoint's generation_config.json,
# which vLLM applies to any request that does not set them.
# VLLM_NO_USAGE_STATS and DO_NOT_TRACK: vLLM reports anonymous usage to its authors by
# default; a box that serves its owner's data sends nothing anywhere.
# vllm_engine_auth.RequireKey: vLLM checks the key only under /v1, /v2, /inference and
# /cohere; the middleware asks it everywhere but /health and /metrics, as the SGLang lanes do.
ExecStart=/bin/bash -c 'exec /usr/bin/docker run --rm --name qwen38-nemotron --gpus all \
  --memory 100g --memory-swap 100g --shm-size 16g --network host --ipc=host \
  -e HF_HUB_OFFLINE=1 -e VLLM_NO_USAGE_STATS=1 -e DO_NOT_TRACK=1 -e VLLM_USE_V2_MODEL_RUNNER=1 \
  -e PYTHONDONTWRITEBYTECODE=1 -e HF_MODULES_CACHE=/tmp/hf-modules \
  -e PYTHONPATH=/opt/qwen38-auth -e QWEN38_KEY_FILE=/out/api-key \
  -v __HOME__/.config/qwen38/nemotron-cache/vllm:/root/.cache/vllm \
  -v __HOME__/.config/qwen38/nemotron-cache/flashinfer:/root/.cache/flashinfer \
  -v __HOME__/.config/qwen38/nemotron-cache/b12x:/root/.cache/b12x \
  -v __HF_CACHE__:/root/.cache/huggingface \
  -v __HOME__/.config/qwen38:/out:ro \
  -v __HOME__/.config/qwen38/vllm-auth:/opt/qwen38-auth:ro \
  __IMAGE__ \
    __MODEL__ --revision __REV__ \
    --served-model-name nemotron-3.5-bolt --trust-remote-code \
    --max-model-len 262144 --max-num-seqs 16 --kv-cache-dtype fp8 \
    --gpu-memory-utilization __GMU__ \
    --linear-backend b12x --moe-backend b12x --attention-backend FLASHINFER --mamba-backend flashinfer \
    --mamba-ssm-cache-dtype bfloat16 --mamba-cache-dtype bfloat16 --seed 42 \
    --block-size 64 --prefix-match-unit 64 --enable-mamba-shared-prefix-checkpoint \
    --limit-mm-per-prompt.image 16 --limit-mm-per-prompt.video 2 --video-pruning-rate 0.5 \
    --media-io-kwargs.video.fps 2 --media-io-kwargs.video.num_frames 256 \
    --allowed-media-domains media.invalid \
    --enable-auto-tool-choice --tool-call-parser qwen3_coder \
    --reasoning-parser-plugin /root/.cache/huggingface/hub/models--__MODEL_DIR__/snapshots/__REV__/ultra_v3_reasoning_parser.py \
    --reasoning-parser ultra_v3 \
    --speculative-config.method dflash --speculative-config.model __DRAFT__ \
    --speculative-config.revision __DREV__ --speculative-config.num_speculative_tokens 7 \
    --speculative-config.rejection_sample_method standard --speculative-config.attention_backend FLASHINFER \
    --speculative-config.draft_load_config.load_format auto \
    --config /out/engine-secrets.yaml --middleware vllm_engine_auth.RequireKey \
    --host __ENGINE_BIND__ --port __PORT__'
ExecStop=-/usr/bin/docker stop -t 20 qwen38-nemotron
Restart=always
# docker stops vLLM with SIGTERM (143) or SIGKILL (137) on a plain stop: a clean stop, not a failure
SuccessExitStatus=137 143
RestartSec=15

[Install]
WantedBy=multi-user.target
